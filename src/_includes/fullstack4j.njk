{#- The fullstack4j offering; text lives in src/_data/fullstack4j.js. Set `showSteps` before including to list the engagement steps. -#}
{%- set f = fullstack4j[lang or "en"] %}
<section class="wrap section offering-section" id="fullstack4j">
  <div class="section-head">
    <h2>{{ f.heading }}</h2>
    <a class="more" href="{{ site.fullstack4j }}" hreflang="en">fullstack4j.dev →</a>
  </div>

  <div class="offering">
    <div class="offering-copy">
      <p class="meta">{{ f.kicker }}</p>
      <h3>{{ f.title }}</h3>
      <p class="pitch">{{ f.text }}</p>
      <ul class="stack" lang="en" aria-label="Stack and method">
        {%- for item in fullstack4j.stack %}
        <li class="sticky {{ 'sticky-green' if item.method else 'sticky-blue' }}">{{ item.label }}</li>
        {%- endfor %}
      </ul>
      <div class="actions">
        <a class="button primary" href="{{ site.fullstack4j }}" hreflang="en">{{ f.visit }}</a>
        <a class="button" href="/fullstack/" hreflang="en">{{ f.why }}</a>
      </div>
    </div>

    {#- One vertical slice on an Event Modeling board: screen → command → event, then the next slice's view -#}
    <figure class="slice-board">
      <svg viewBox="0 0 374 324" role="img" aria-label="{{ f.sliceAlt }}">
        <defs>
          <marker id="em-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0L10 5L0 10z" fill="currentColor"/>
          </marker>
        </defs>

        <line class="em-lane" x1="0" y1="106" x2="374" y2="106"/>
        <line class="em-lane" x1="0" y1="214" x2="374" y2="214"/>
        <text class="em-lane-label" x="0" y="14">UI</text>
        <text class="em-lane-label" x="0" y="122">COMMAND · VIEW</text>
        <text class="em-lane-label" x="0" y="230">EVENT</text>

        <g transform="translate(14 0)">
        <rect class="em-slice" x="80" y="22" width="128" height="298" rx="14"/>

        <rect class="em-wire" x="96" y="34" width="96" height="62" rx="6"/>
        <text class="em-wire-title" x="104" y="49">Open orders</text>
        <rect class="em-wire-line" x="104" y="56" width="62" height="5" rx="2.5"/>
        <rect class="em-wire-line" x="104" y="65" width="48" height="5" rx="2.5"/>
        <rect class="em-button" x="150" y="75" width="34" height="15" rx="7.5"/>
        <text class="em-button-text" x="167" y="85.5" text-anchor="middle">Ship</text>

        <g transform="rotate(-2 144 160)">
          <rect class="em-note em-cmd" x="94" y="137" width="100" height="46" rx="3"/>
          <text class="em-note-text" x="144" y="164" text-anchor="middle">ShipOrder</text>
        </g>
        <g transform="rotate(1.5 144 268)">
          <rect class="em-note em-evt" x="94" y="245" width="100" height="46" rx="3"/>
          <text class="em-note-text" x="144" y="272" text-anchor="middle">OrderShipped</text>
        </g>

        <line class="em-arrow" x1="144" y1="96" x2="144" y2="132" marker-end="url(#em-arrow)"/>
        <line class="em-arrow" x1="144" y1="184" x2="144" y2="240" marker-end="url(#em-arrow)"/>

        <g class="em-next">
          <rect class="em-wire" x="244" y="34" width="96" height="62" rx="6"/>
          <text class="em-wire-title" x="252" y="49">Billing</text>
          <rect class="em-wire-line" x="252" y="56" width="70" height="5" rx="2.5"/>
          <rect class="em-wire-line" x="252" y="65" width="56" height="5" rx="2.5"/>
          <rect class="em-wire-line" x="252" y="74" width="40" height="5" rx="2.5"/>
          <g transform="rotate(2 292 160)">
            <rect class="em-note em-view" x="242" y="137" width="100" height="46" rx="3"/>
            <text class="em-note-text" x="292" y="164" text-anchor="middle">OrdersToBill</text>
          </g>
          <path class="em-arrow" d="M196 266 C 250 266, 292 236, 292 188" marker-end="url(#em-arrow)"/>
          <line class="em-arrow" x1="292" y1="136" x2="292" y2="100" marker-end="url(#em-arrow)"/>
          <text class="em-tag" x="292" y="300" text-anchor="middle">next slice</text>
        </g>
        </g>
      </svg>
      <figcaption>{{ f.sliceCaption }}</figcaption>
    </figure>
  </div>

  {%- if showSteps %}
  <ol class="offering-steps" aria-label="{{ f.stepsLabel }}">
    {%- for step in f.steps %}
    <li>
      <p class="meta">{{ step.meta }}</p>
      <h3>{{ step.title }}</h3>
      <p>{{ step.text }}</p>
    </li>
    {%- endfor %}
  </ol>
  {%- endif %}
</section>
